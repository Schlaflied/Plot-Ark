# AI Provider — set one or both, then select via AI_PROVIDER
AI_PROVIDER=openai        # openai | gemini | local

# Local-model mode (AI_PROVIDER=local): any Ollama-compatible endpoint.
# LOCAL_LLM_BASE_URL=http://localhost:11434
# LOCAL_LLM_MODEL=llama3.1:8b
# LOCAL_LLM_TIMEOUT=120

OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Required before API keys can be saved through the professor/student GUI.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=replace_with_generated_fernet_key
